# Bantay Pondo — Production Environment Configuration

# Domain & SSL
DOMAIN=bantaypondo.ph
SSL_EMAIL=security@bantaypondo.ph
SSL_STAGING=0

# PostgreSQL + PostGIS Database
POSTGRES_DB=bantay_pondo
POSTGRES_USER=bantay_prod
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Redis Cache
REDIS_PASSWORD=CHANGE_ME_TO_A_SECURE_REDIS_PASSWORD

# Application
DATA_VERSION=2026.09.21.01
LOG_LEVEL=INFO
